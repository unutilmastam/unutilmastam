{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/next-env.d.ts",
      "!**/*.css",
      "!**/*.md",
      "!**/*.svg"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": { "noDangerouslySetInnerHtml": "warn" },
      "style": { "noNonNullAssertion": "error" },
      "performance": { "noImgElement": "off" }
    }
  },
  "overrides": [{ "includes": ["**/tests/**"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } } }],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
