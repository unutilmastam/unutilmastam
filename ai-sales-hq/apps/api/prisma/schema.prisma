// Operational database for AI Sales HQ (MySQL 8, see docs/DECISIONS.md D-007).
// Conventions: UTC DateTime columns, money as BigInt so'm, snake_case tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  STAFF
}

model User {
  id                 String              @id @default(uuid()) @db.Char(36)
  username           String              @unique @db.VarChar(64)
  displayName        String              @map("display_name") @db.VarChar(120)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               Role
  isActive           Boolean             @default(true) @map("is_active")
  totpSecretEnc      String?             @map("totp_secret_enc") @db.VarChar(255)
  totpPendingEnc     String?             @map("totp_pending_enc") @db.VarChar(255)
  totpEnabledAt      DateTime?           @map("totp_enabled_at")
  totpLastStep       BigInt?             @map("totp_last_step")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  sessions           Session[]
  totpRecoveryCodes  TotpRecoveryCode[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  userId      String    @map("user_id") @db.Char(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  csrfToken   String    @map("csrf_token") @db.Char(43)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model TotpRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("totp_recovery_codes")
}

model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  username    String   @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  succeeded   Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([username, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// Append-only. Never cascade-deleted (MASTER_SPEC §14).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorType   String   @map("actor_type") @db.VarChar(16)
  actorId     String?  @map("actor_id") @db.VarChar(64)
  action      String   @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
