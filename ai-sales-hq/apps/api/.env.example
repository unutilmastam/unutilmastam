# AI Sales HQ API — copy to apps/api/.env on the server (never commit .env).
# On cPanel the file lives outside public_html; permissions 600.

NODE_ENV=production
# Passenger intercepts listen(); PORT/HOST matter only for local runs.
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# MySQL 8 created in cPanel -> MySQL Databases. Use socketPath if TCP is not available:
# mysql://user:password@localhost/dbname?socketPath=/var/lib/mysql/mysql.sock
DATABASE_URL=mysql://hq_user:CHANGE_ME@localhost:3306/hq_db

# Public address of the app (https in production).
APP_ORIGIN=https://agent.unutilmastam.uz

# Random secret, at least 32 characters. Encrypts 2FA seeds; changing it disables existing 2FA.
APP_SECRET_KEY=

# One-time code for creating the owner account at /setup. Remove after the owner exists.
SETUP_TOKEN=

SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY=true
# Defaults to true in production (SPEC_AMENDMENTS A11).
# TOTP_REQUIRED=true
