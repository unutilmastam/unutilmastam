# AI Sales HQ API — copy to apps/api/.env on the server (never commit .env).
# On cPanel the file lives outside public_html; permissions 600.

NODE_ENV=production
# Passenger intercepts listen(); PORT/HOST matter only for local runs.
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# MySQL 8 created in cPanel -> MySQL Databases. Use socketPath if TCP is not available:
# mysql://user:password@localhost/dbname?socketPath=/var/lib/mysql/mysql.sock
DATABASE_URL=mysql://hq_user:CHANGE_ME@localhost:3306/hq_db

# Public address of the app (https in production).
APP_ORIGIN=https://agent.unutilmastam.uz

# Random secret, at least 32 characters. Encrypts 2FA seeds; changing it disables existing 2FA.
APP_SECRET_KEY=

# One-time code for creating the owner account at /setup. Remove after the owner exists.
SETUP_TOKEN=

SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY=true
# Defaults to true in production (SPEC_AMENDMENTS A11).
# TOTP_REQUIRED=true

# Read-only Firestore catalog sync (docs/FIRESTORE_SETUP_UZ.md). Leave empty = NOT_CONFIGURED.
# FIREBASE_SERVICE_ACCOUNT_FILE=/home/<user>/ai-sales-hq-data/firebase-sa.json

# Owner-only Telegram bot (A5): create a NEW bot with @BotFather, never reuse the customer bot.
# TELEGRAM_BOT_TOKEN=
# Numeric chat ids allowed to use the bot, comma-separated (send /start to @userinfobot to see yours).
# TELEGRAM_OWNER_CHAT_IDS=
# Random 24+ characters [A-Za-z0-9_-]; Telegram sends it back on every webhook call.
# TELEGRAM_WEBHOOK_SECRET=

# Cron (cPanel -> Cron Jobs), every minute:
# * * * * * cd $HOME/ai-sales-hq/ai-sales-hq/apps/api && /home/<user>/nodevenv/ai-sales-hq/22/bin/node dist/worker.js --once >> $HOME/ai-sales-hq-data/worker.log 2>&1

# Google Places API (New) for prospect discovery (optional, docs/GOOGLE_PLACES_SETUP_UZ.md).
# GOOGLE_PLACES_API_KEY=
