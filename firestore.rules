rules_version = '2';

// Qarz Daftar — Firestore xavfsizlik qoidalari
// Har bir foydalanuvchi FAQAT o'zining ma'lumotini o'qiy va yoza oladi.
// Boshqa hech kim (hatto boshqa ro'yxatdan o'tgan foydalanuvchi ham) ko'ra olmaydi.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // foydalanuvchi hujjatining o'zi
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // debts / pays / cheks — barcha ichki to'plamlar
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Qolgan hamma narsa taqiqlangan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
