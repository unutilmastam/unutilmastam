# ============================================================================
#  LabCore sozlamalari. Nusxa oling:  cp .env.example .env
#  DIQQAT: .env faylini git'ga qo'shmang va faqat server administratori
#  o'qiy oladigan qilib qo'ying:  chmod 600 .env
# ============================================================================

# --- Ma'lumotlar bazasi (lokal laboratoriya serveri) ---
DATABASE_URL=postgres://labcore:PAROLNI_ALMASHTIRING@127.0.0.1:5432/labcore
DB_POOL_MAX=10

# --- Server ---
PORT=4000
# Faqat lokal tarmoqdan kirish uchun serverning ichki IP manzilini yozing,
# masalan: 192.168.1.10. Internetga ochiq qo'ymang.
HOST=0.0.0.0
NODE_ENV=production

# --- Fayl arxivi (bemor papkalari shu yerda saqlanadi) ---
DATA_DIR=/var/lib/labcore
MAX_UPLOAD_MB=50

# --- HTTPS ---
# Telefonga ilova o'rnatish (PWA) va oflayn rejim faqat HTTPS'da ishlaydi.
# Sertifikat ko'rsatilsa nginx kerak emas — server o'zi shifrlangan ulanishda ishlaydi.
SSL_CERT_FILE=
SSL_KEY_FILE=
# HTTP portida turib HTTPS'ga yo'naltirish (0 = o'chirilgan)
SSL_REDIRECT_FROM_PORT=0

# --- Xavfsizlik ---
# Kamida 32 baytli tasodifiy satr:  openssl rand -hex 48
JWT_SECRET=
SESSION_HOURS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Laborant o'z yozuvini necha soat ichida tuzata oladi (undan keyin — faqat admin)
EDIT_WINDOW_HOURS=24
# Xodim "onlayn" deb hisoblanadigan oxirgi faollik oynasi (daqiqa)
ONLINE_WINDOW_MINUTES=10

# --- Laboratoriya ---
LAB_NAME=Markaziy laboratoriya
CURRENCY=so'm
TZ_NAME=Asia/Tashkent

# --- Bildirishnomalar (ixtiyoriy; bo'sh qoldirilsa xabarlar navbatda saqlanadi) ---
TELEGRAM_BOT_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMTP_URL=
NOTIFY_INTERVAL_MS=30000

# --- Navbat (registratura) ---
APPOINTMENT_SLOT_MINUTES=15      # bitta oraliq uzunligi
APPOINTMENT_CAPACITY=2           # bitta oraliqqa nechta bemor
WORK_START=08:00
WORK_END=18:00
APPOINTMENT_REMINDER_MINUTES=60  # necha daqiqa oldin eslatma yuborilsin

# --- Kameralar va davomat ---
# Yuz tanish hodisalari orasidagi tanaffus shu qiymatdan kichik bo'lsa,
# ular bitta "ish joyida edi" oralig'iga birlashtiriladi (daqiqa)
PRESENCE_GAP_MINUTES=10
# Kamera hodisalarini saqlash muddati (kun). Muddat tugagach avtomatik o'chadi.
CAMERA_RETENTION_DAYS=90

# --- Zaxira nusxa ---
BACKUP_KEEP_DAYS=30
# Lokal tarmoqdagi ikkinchi kompyuter yoki NAS:
# RSYNC_TARGET=labcore@backup-server:/backups/labcore
RSYNC_TARGET=
# Bulutga nusxa (avval: rclone config). Masalan: labcloud:labcore-backup
RCLONE_REMOTE=
# Bulutga chiqadigan nusxani shifrlash paroli. BO'SH QOLDIRMANG —
# parolsiz tibbiy ma'lumot bulutga yuborilmaydi.
BACKUP_PASSPHRASE=
