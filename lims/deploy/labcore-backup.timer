# Har kuni 01:30 da zaxiralash.
#   sudo cp deploy/labcore-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now labcore-backup.timer
[Unit]
Description=LabCore zaxira nusxasini kunlik ishga tushirish

[Timer]
OnCalendar=*-*-* 01:30:00
Persistent=true

[Install]
WantedBy=timers.target
