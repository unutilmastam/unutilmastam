# ============================================================================
#  Ixtiyoriy: laboratoriya ichki tarmog'ida HTTPS bilan ishlatish.
#  Tibbiy ma'lumot lokal tarmoqda ham shifrlangan kanal orqali yurishi kerak.
#
#  1) O'z-o'zini imzolagan sertifikat (ichki tarmoq uchun yetarli):
#     openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
#       -keyout /etc/ssl/private/labcore.key \
#       -out /etc/ssl/certs/labcore.crt \
#       -subj "/CN=labcore.lab.local"
#
#  2) Ish stansiyalarida sertifikatni ishonchli ro'yxatga qo'shing.
# ============================================================================

server {
    listen 80;
    server_name labcore.lab.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name labcore.lab.local;

    ssl_certificate     /etc/ssl/certs/labcore.crt;
    ssl_certificate_key /etc/ssl/private/labcore.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Faqat ichki tarmoqdan kirish (o'z tarmog'ingizga moslang)
    allow 192.168.1.0/24;
    allow 127.0.0.1;
    deny all;

    # Analiz fayllari (rentgen, UTT) katta bo'lishi mumkin
    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
