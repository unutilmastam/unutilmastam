# Laboratoriya serverida LabCore'ni xizmat sifatida ishga tushirish.
#   sudo cp deploy/labcore.service /etc/systemd/system/
#   sudo systemctl enable --now labcore
[Unit]
Description=LabCore LIMS — laboratoriya boshqaruv tizimi
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=labcore
Group=labcore
WorkingDirectory=/opt/labcore
EnvironmentFile=/opt/labcore/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

# Xavfsizlik cheklovlari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/labcore /opt/labcore/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=labcore

[Install]
WantedBy=multi-user.target
