{
  "name": "labcore-desktop",
  "version": "1.0.0",
  "description": "LabCore — laboratoriya ish stansiyasi dasturi (Windows)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win-portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.labcore.desktop",
    "productName": "LabCore",
    "copyright": "LabCore LIMS",
    "files": ["main.js", "preload.js", "setup.html", "setup.js", "icon.png"],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabCore"
    }
  }
}
