# ==========================================================
# Binance Spot Scalping Signal Bot - configuration example
# Copy to .env and fill in your own values:  cp .env.example .env
# NEVER commit the real .env file.
# ==========================================================

# ---------- Binance ----------
# Optional. Public market data (klines / depth / ticker) works without keys.
# Keys are used ONLY for market data requests and are never sent to Telegram.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# ---------- Telegram ----------
# Create a bot with @BotFather and get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma separated whitelist of chat ids allowed to talk to the bot.
# Leave empty to allow only TELEGRAM_CHAT_ID.
AUTHORIZED_CHAT_IDS=

# ---------- Symbol scanner ----------
QUOTE_ASSET=USDT
MAX_SYMBOLS=30
# Minimum 24h quote volume (USDT) required for a symbol to be tracked
MIN_24H_VOLUME=50000000
# Maximum allowed bid/ask spread in percent
MAX_SPREAD_PERCENT=0.06
# Always-include list (still validated against exchange trading status)
PRIORITY_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT
# Never trade these (leveraged tokens / stablecoin pairs are filtered anyway)
BLACKLIST_SYMBOLS=
# How often (minutes) the symbol universe is rescanned
SCANNER_REFRESH_MINUTES=60

# ---------- Signal engine ----------
MIN_SIGNAL_SCORE=75
SIGNAL_COOLDOWN_MINUTES=5
# A repeated signal is only re-sent if the score moved at least this much
SIGNAL_SCORE_DELTA=8
# Market data older than this many seconds is considered stale -> no signals
MAX_DATA_AGE_SECONDS=90

# ---------- Risk management ----------
RISK_PER_TRADE=0.01
ATR_SL_MULTIPLIER=1.2
MIN_RISK_REWARD=1.5
# Reject a setup when the stop distance is below/above these bounds (percent)
MIN_STOP_DISTANCE_PERCENT=0.15
MAX_STOP_DISTANCE_PERCENT=3.0
# Reject when the signal candle already moved more than this (percent)
MAX_CANDLE_MOVE_PERCENT=1.5
# Volatility guard: ATR as percent of price
MAX_ATR_PERCENT=5.0
# RSI hard bounds
RSI_MAX=75
RSI_MIN=25
# Minimum volume ratio (current / avg20) required
MIN_VOLUME_RATIO=1.2

# ---------- Paper trading ----------
PAPER_TRADING=true
REAL_TRADING=false
PAPER_START_BALANCE=1000
# Split of the position closed at each take profit level
TP_ALLOCATION=0.5,0.3,0.2
# Largest share of the account one position may use. A tight stop makes the
# risk-based size exceed the balance, so without this cap a single signal
# would consume the whole account and block every other symbol.
MAX_POSITION_PERCENT=0.25

# ---------- Infrastructure ----------
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_API=true
